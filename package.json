{
  "name": "busmovil",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest",
    "proxy": "ts-node proxy/server.ts",
    "typecheck": "tsc --noEmit",
    "build:android": "cd android && ./gradlew assembleDebug",
    "emulator": "node scripts/android-emulator.cjs start",
    "emulator:gps": "node scripts/android-emulator.cjs gps",
    "emulator:stops": "node scripts/android-emulator.cjs stops",
    "emulator:stop": "node scripts/android-emulator.cjs stop",
    "test:emulator": "python3 scripts/emulator-qa.py all",
    "emulator:gps:stop": "node scripts/android-emulator.cjs gps-stop",
    "rail:catalog": "python3 scripts/import-rail.py"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-permissions": "^4.1.5",
    "react-native-webview": "^13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@react-native/babel-preset": "0.74.87",
    "@react-native/metro-config": "0.74.87",
    "@react-native/typescript-config": "0.74.87",
    "@types/express": "^5.0.3",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-react": "^7.33.2",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
